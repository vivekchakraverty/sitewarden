{
  "name": "sitewarden",
  "version": "0.1.0",
  "description": "Bring-your-own-key website security scanner: quick checks, malware/blacklist lookups, Nuclei + ZAP deep scans, Cloudflare hardening and 24/7 monitoring.",
  "author": {
    "name": "Vivek Chakraverty"
  },
  "license": "MIT",
  "homepage": "https://github.com/vivekchakraverty/sitewarden",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivekchakraverty/sitewarden.git"
  },
  "bugs": {
    "url": "https://github.com/vivekchakraverty/sitewarden/issues"
  },
  "keywords": [
    "security",
    "scanner",
    "website",
    "nuclei",
    "zap",
    "cloudflare",
    "electron"
  ],
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:win": "npm run build && electron-builder --win",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --outfile=out/smoke.cjs --log-level=warning && node out/smoke.cjs",
    "postinstall": "node scripts/postinstall.mjs",
    "test": "node scripts/test/run.mjs",
    "e2e:deep": "node scripts/test/run.mjs deep-e2e"
  },
  "build": {
    "appId": "app.sitewarden.desktop",
    "productName": "SiteWarden",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "SiteWarden-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  }
}
